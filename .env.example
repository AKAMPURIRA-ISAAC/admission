# applications are still saved, but email notifications are not sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contactissacharswe@gmail.com
SMTP_PASS=your_google_app_password
ADMISSIONS_EMAIL_FROM="Heart & Hands Admissions <contactissacharswe@gmail.com>"
ADMISSIONS_EMAIL_TO=contactissacharswe@gmail.com
